{
  "name": "ghost-vipapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/provision-basic-owner.mjs && next build --webpack && node ./scripts/fix-middleware-trace.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:contract && npm run test:pii-safety",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "test:pii-safety": "node scripts/check-artifact-safety.mjs",
    "smoke:production": "node scripts/prod-e2e.mjs",
    "e2e:staging:mutation": "node scripts/staging-mutation-e2e.mjs",
    "e2e:staging:release": "node scripts/staging-release-regression.mjs",
    "test:a11y": "node scripts/a11y-visual.mjs",
    "test:maintenance": "node scripts/maintenance-anchor-runtime.mjs",
    "verify:backup-restore": "node scripts/verify-backup-restore-manifest.mjs",
    "verify:deployment-release": "node scripts/verify-deployment-release-manifest.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:maintenance && npm run test:a11y"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "lucide-react": "1.7.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "playwright-core": "^1.61.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
